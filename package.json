{
    "name": "@mat3ra/code",
    "version": "0.0.0",
    "description": "COre DEfinitions",
    "scripts": {
        "lint": "eslint --cache src/js tests/js && prettier --write src/js tests/js",
        "lint:fix": "eslint --fix --cache src/js tests/js && prettier --write src/js tests/js",
        "lint:staged": "lint-staged",
        "prepare": "husky install",
        "prettier": "prettier --check src/js tests/js",
        "test": "nyc --reporter=text mocha --recursive --bail tests/js",
        "transpile": "tsc -p tsconfig-transpile.json",
        "generate-mixins": "ts-node scripts/generate-mixins.ts",
        "prepublishOnly": "npm run transpile"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/mat3ra/code.js.git"
    },
    "main": "./dist/js/index.js",
    "files": [
        "/dist",
        "/src/js",
        ".babelrc",
        "modules.d.ts",
        "tsconfig.json"
    ],
    "author": "Exabyte Inc.",
    "bugs": {
        "url": "https://github.com/mat3ra/code.js/issues"
    },
    "license": "Apache-2.0",
    "homepage": "https://github.com/mat3ra/code.js",
    "dependencies": {
        "@types/mathjs": "^5.0.1",
        "ajv": "^8.20.0",
        "ajv-formats": "^2.1.1",
        "ajv-keywords": "^5.1.0",
        "crypto-js": "^4.2.0",
        "js-yaml": "^4.3.2",
        "json-pointer": "^0.6.2",
        "json-schema": "^0.4.0",
        "json-schema-merge-allof": "^0.8.1",
        "lodash": "^4.18.*",
        "mathjs": "^5.10.3",
        "mixwith": "^0.1.1",
        "nunjucks": "^3.2.4",
        "semver": "^7.8.6",
        "underscore": "^1.13.8",
        "underscore.string": "^3.3.6",
        "uuid": "8.3.2"
    },
    "devDependencies": {
        "@babel/cli": "^7.29.7",
        "@babel/core": "^7.29.13",
        "@babel/eslint-parser": "^7.29.13",
        "@babel/plugin-proposal-class-properties": "^7.18.6",
        "@babel/preset-env": "^7.29.14",
        "@babel/preset-react": "^7.29.7",
        "@babel/preset-typescript": "^7.29.7",
        "@babel/register": "^7.29.13",
        "@babel/runtime-corejs3": "^7.29.15",
        "@mat3ra/eslint-config": "^2026.7.12-0",
        "@mat3ra/esse": "https://github.com/mat3ra/esse/releases/download/wip-d45a08e/esse.tgz",
        "@mat3ra/tsconfig": "2024.6.3-0",
        "@types/chai": "^4.3.20",
        "@types/crypto-js": "^4.2.2",
        "@types/js-yaml": "^4.0.9",
        "@types/json-pointer": "^1.0.34",
        "@types/json-schema": "^7.0.15",
        "@types/json-schema-merge-allof": "^0.6.5",
        "@types/mocha": "^10.0.10",
        "@types/node": "^20.19.43",
        "@types/underscore": "^1.13.0",
        "@typescript-eslint/eslint-plugin": "^5.62.0",
        "@typescript-eslint/parser": "^5.62.0",
        "chai": "^4.5.0",
        "eslint": "7.32.0",
        "eslint-config-airbnb": "^19.0.4",
        "eslint-config-prettier": "^8.10.2",
        "eslint-import-resolver-exports": "^1.0.0-beta.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsdoc": "^50.8.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-mui-path-imports": "^0.0.15",
        "eslint-plugin-prettier": "^4.2.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-simple-import-sort": "^7.0.0",
        "husky": "^7.0.4",
        "lint-staged": "^12.5.0",
        "mocha": "10.8.2",
        "nyc": "^15.1.0",
        "prettier": "^2.8.8",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    },
    "peerDependencies": {
        "@mat3ra/esse": "*"
    },
    "engines": {
        "node": ">=12.0.0"
    },
    "lint-staged": {
        "src/js/**/*.{js,ts}": "eslint --cache --fix",
        "tests/js/**/*.{js,ts}": "eslint --cache --fix",
        "src/js/**/*.{js,ts,css}": "prettier --write",
        "tests/js/**/*.{js,ts,css}": "prettier --write"
    }
}
